#!/usr/bin/env python3
# kantortun-httpd - Proxy HTTP & CONNECT lokal untuk tool CLI
#
# Mendukung:
# 1. HTTP CONNECT (HTTPS, WebSocket, SSE/streaming) - untuk Claude Code, Node undici, curl, dll.
# 2. Plain HTTP forwarding (GET/POST http://...) - untuk CLI/package manager yang memakai HTTP_PROXY.
# 3. Meneruskan koneksi ke SOCKS5 kantortun (127.0.0.1:1080) jika aktif, dan fallback direct jika mati.
# 4. Penanganan TCP half-close (SHUT_WR) agar streaming, upload payload besar, dan thinking mode tidak terputus.

import socket
import sys
import threading
from urllib.parse import urlsplit

LISTEN_ADDR = '127.0.0.1'
LISTEN_PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8118
SOCKS_ADDR = '127.0.0.1'
SOCKS_PORT = 1080
CONNECT_TIMEOUT = 12
HEADER_TIMEOUT = 30
BUF = 65536


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def recv_exact(sock, n):
    data = b''
    while len(data) < n:
        chunk = sock.recv(n - len(data))
        if not chunk:
            raise OSError('koneksi putus saat handshake SOCKS5')
        data += chunk
    return data


def connect_via_socks(host, port):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
    s.settimeout(CONNECT_TIMEOUT)
    s.connect((SOCKS_ADDR, SOCKS_PORT))
    s.sendall(b'\x05\x01\x00')
    if recv_exact(s, 2) != b'\x05\x00':
        s.close()
        raise OSError('SOCKS5 menolak metode tanpa auth')
    # ATYP 3 = domain name (DNS resolved di VPS)
    encoded_host = host.encode('idna')
    req = b'\x05\x01\x00\x03' + bytes([len(encoded_host)]) + encoded_host + port.to_bytes(2, 'big')
    s.sendall(req)
    head = recv_exact(s, 4)
    if head[1] != 0:
        s.close()
        raise OSError('SOCKS5 gagal connect, status %d' % head[1])
    if head[3] == 1:
        recv_exact(s, 6)
    elif head[3] == 3:
        recv_exact(s, recv_exact(s, 1)[0] + 2)
    elif head[3] == 4:
        recv_exact(s, 18)
    s.settimeout(None)
    return s


def connect_direct(host, port):
    s = socket.create_connection((host, port), timeout=CONNECT_TIMEOUT)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
    s.settimeout(None)
    return s


def get_upstream(host, port):
    via = 'socks'
    try:
        upstream = connect_via_socks(host, port)
    except OSError:
        via = 'direct'
        upstream = connect_direct(host, port)
    return upstream, via


def pipe(src, dst):
    try:
        while True:
            data = src.recv(BUF)
            if not data:
                break
            dst.sendall(data)
    except OSError:
        pass
    finally:
        try:
            dst.shutdown(socket.SHUT_WR)
        except OSError:
            pass


def handle(client, addr):
    upstream = None
    try:
        client.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
        client.settimeout(HEADER_TIMEOUT)
        buf = b''
        while b'\r\n\r\n' not in buf:
            chunk = client.recv(BUF)
            if not chunk:
                return
            buf += chunk
            if len(buf) > 65536:
                client.sendall(b'HTTP/1.1 431 Request Header Fields Too Large\r\n\r\n')
                return
        head, _, rest = buf.partition(b'\r\n\r\n')
        lines = head.split(b'\r\n')
        if not lines or not lines[0]:
            return
        parts = lines[0].split()
        if len(parts) < 2:
            return

        method = parts[0].decode('latin1', 'replace').upper()
        raw_target = parts[1].decode('latin1', 'replace')

        if method == 'CONNECT':
            host, _, port_str = raw_target.rpartition(':')
            if not host:
                host = raw_target
                port = 443
            else:
                port = int(port_str) if port_str.isdigit() else 443

            try:
                upstream, via = get_upstream(host, port)
            except OSError as exc:
                log('%s CONNECT %s:%d gagal: %s' % (addr[0], host, port, exc))
                client.sendall(b'HTTP/1.1 502 Bad Gateway\r\n'
                               b'Content-Type: text/plain; charset=utf-8\r\n'
                               b'Connection: close\r\n\r\n'
                               b'kantortun: gagal menyambung ke tujuan.\r\n')
                return

            client.sendall(b'HTTP/1.1 200 Connection Established\r\n\r\n')
            if rest:
                upstream.sendall(rest)
            client.settimeout(None)
            log('%s CONNECT %s:%d (%s)' % (addr[0], host, port, via))

        else:
            # Plain HTTP request (GET, POST, dll.)
            parsed = urlsplit(raw_target)
            host = parsed.hostname
            if not host:
                for line in lines[1:]:
                    if line.lower().startswith(b'host:'):
                        host = line.split(b':', 1)[1].strip().decode('latin1', 'replace')
                        if ':' in host:
                            host, _, p = host.rpartition(':')
                            port = int(p) if p.isdigit() else 80
                        else:
                            port = 80
                        break
                if not host:
                    client.sendall(b'HTTP/1.1 400 Bad Request\r\n\r\n')
                    return
            else:
                port = parsed.port or 80

            path = (parsed.path or '/') + (('?' + parsed.query) if parsed.query else '')
            http_version = parts[2] if len(parts) > 2 else b'HTTP/1.1'
            new_first_line = f'{method} {path} '.encode('latin1') + http_version
            new_head = b'\r\n'.join([new_first_line] + lines[1:]) + b'\r\n\r\n'

            try:
                upstream, via = get_upstream(host, port)
            except OSError as exc:
                log('%s %s %s:%d gagal: %s' % (addr[0], method, host, port, exc))
                client.sendall(b'HTTP/1.1 502 Bad Gateway\r\n'
                               b'Content-Type: text/plain; charset=utf-8\r\n'
                               b'Connection: close\r\n\r\n'
                               b'kantortun: gagal menyambung ke tujuan.\r\n')
                return

            upstream.sendall(new_head)
            if rest:
                upstream.sendall(rest)
            client.settimeout(None)
            log('%s %s %s:%d (%s)' % (addr[0], method, host, port, via))

        t = threading.Thread(target=pipe, args=(client, upstream), daemon=True)
        t.start()
        pipe(upstream, client)

    except Exception as exc:  # noqa: BLE001
        log('gagal %s: %s' % (addr[0], exc))
    finally:
        for s in (client, upstream):
            if s is not None:
                try:
                    s.close()
                except OSError:
                    pass


def main():
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind((LISTEN_ADDR, LISTEN_PORT))
    srv.listen(64)
    log('kantortun-httpd listen di %s:%d (SOCKS %s:%d, fallback langsung)'
        % (LISTEN_ADDR, LISTEN_PORT, SOCKS_ADDR, SOCKS_PORT))
    while True:
        try:
            client, addr = srv.accept()
        except OSError as exc:
            log('accept gagal: %s' % exc)
            continue
        threading.Thread(target=handle, args=(client, addr), daemon=True).start()


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
