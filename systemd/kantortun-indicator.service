[Unit]
Description=kantortun tray indicator
Documentation=file:%h/.local/bin/kantortun-indicator
Requires=dbus.socket
After=dbus.socket

[Service]
Type=simple
ExecStart=%h/.local/bin/kantortun-indicator
# Dipicu oleh ~/.config/autostart/kantortun-indicator.desktop, bukan oleh
# graphical-session.target, supaya urutannya sama seperti autostart biasa (ikon
# muncul setelah panel siap) tapi prosesnya tetap diawasi systemd.
Restart=always
RestartSec=3
StandardOutput=append:/tmp/kantortun-indicator.log
StandardError=append:/tmp/kantortun-indicator.log

[Install]
WantedBy=default.target